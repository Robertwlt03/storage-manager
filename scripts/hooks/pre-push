#!/usr/bin/env python3
"""Runs the whole check pipeline before git sends commits to GitHub, so nothing red leaves the Mac.

Start:  git push, once make hooks told git where its hooks are; git push --no-verify skips it
Needs:  what make check needs (Xcode 27, SwiftLint, Python 3.13 or newer)
git starts this file with whatever python3 it finds, perhaps the 3.9 Xcode brings, so it only
asks make for the Python it picks (make python-path) and starts scripts/push-check.py with it.
The list of pushed branches that git writes goes along, as both read the same input.
"""

import subprocess
import sys

# MARK: Run

python = subprocess.run(
    ["make", "--no-print-directory", "python-path"], capture_output=True, text=True
).stdout.strip()
sys.exit(subprocess.run([python or "python3", "scripts/push-check.py"]).returncode)
